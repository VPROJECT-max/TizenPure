<?xml version="1.0" encoding="UTF-8"?>
<!-- TizenPure hello-world: proves certificate + sign + install + uninstall on a TV
     before the real launcher goes on. No privileges, no service, no network. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/VPROJECT-max/TizenPure/hello" version="1.0.0" viewmodes="maximized">
  <tizen:application id="TizenPureH.Hello" package="TizenPureH" required_version="2.4"/>
  <name>TizenPure Hello</name>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
